# ReelBot — все переменные окружения.
# Скопируйте в .env и заполните. Секреты только здесь, никогда в коде (§6).

# ============================================================ Telegram

# Токен от @BotFather
BOT_TOKEN=

# api_id / api_hash с https://my.telegram.org — нужны ЛОКАЛЬНОМУ Bot API серверу.
# Без него лимит файла 20 МБ, с ним — 2 ГБ (§1).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Пусто → облачный Bot API (лимит 20 МБ).
# http://localhost:8081 → сервер из docker-compose (лимит 2 ГБ).
# Перед первым переключением на локальный сервер один раз выполните:
#   curl "https://api.telegram.org/bot$BOT_TOKEN/logOut"
BOT_API_URL=

# ⚠ Локальный Bot API отдаёт ЛОКАЛЬНЫЕ ПУТИ к файлам, а не URL (M0 ⚠).
# bot.download_file() с ним не работает — файл читается напрямую с этого тома,
# поэтому том смонтирован и в контейнер, и на хост.
BOT_API_DATA_DIR_HOST=./data/telegram-bot-api
BOT_API_DATA_DIR_CONTAINER=/var/lib/telegram-bot-api

# user_id владельцев: им не действуют лимиты, им же видна себестоимость в /stats
ADMIN_IDS=[]

# ============================================================ Инфраструктура

# Порты на хосте для docker-compose (меняйте, если заняты)
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=9000
S3_CONSOLE_PORT=9001
BOT_API_PORT=8081

POSTGRES_USER=reelbot
POSTGRES_PASSWORD=reelbot
POSTGRES_DB=reelbot

POSTGRES_DSN=postgresql+asyncpg://reelbot:reelbot@localhost:5432/reelbot
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=reelbot
S3_SECRET_KEY=reelbot-secret
S3_BUCKET=reelbot
S3_REGION=us-east-1

# Рабочие папки джобов. DEBUG=1 их не удаляет.
WORK_DIR=./data/work

# ============================================================ LLM (§4)

# Провайдер — деталь реализации за абстрактным клиентом, как и имя модели.
# anthropic | deepseek | gemini | fal
# fal — те же Gemini через шлюз fal, ключом FAL_API_KEY (он же рисует
# картинки). Бесплатного тарифа с лимитом 20 запросов в сутки там нет.
LLM_PROVIDER=fal

# Нужен ключ ТОЛЬКО выбранного провайдера (у fal — FAL_API_KEY ниже). Без него режиссёр работает
# ДЕТЕРМИНИРОВАННО: блоки по паузам и лимитам, без акцентов и b-roll.
# Ролик всё равно соберётся (§3, фолбэк).
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Тир → модель. Вызывающий код знает только тир.
# Пусто → модель по умолчанию для провайдера (PROVIDER_MODELS в core/config.py):
#   anthropic: haiku-4-5 / opus-5 / sonnet-5
#   deepseek:  v4-flash  / v4-pro / v4-flash-vision-exp
#   gemini:    3.1-flash-lite / 3.1-pro-preview / 3.7-flash
#   fal:       google/gemini-3.1-flash-lite / google/gemini-3.5-flash / то же
LLM_TIER_CHEAP=
LLM_TIER_SMART=
LLM_TIER_VISION=

# Ретрай ровно один: второй провал → фолбэк, не третья попытка (§4).
LLM_MAX_RETRIES=1
LLM_TIMEOUT_S=180
LLM_ENABLED=1

# ============================================================ ASR (M1)

# auto → whisperx, если установлен, иначе faster_whisper.
#
# whisperx считает границы слов отдельной моделью (wav2vec2) по звуку. Замерено
# инструментом tests/asr_accuracy.py; ВСЕ числа — при ASR_TRIM_WORD_SILENCE=1,
# то есть при поставляемых настройках, вторая колонка — без обрезки, чтобы не
# смешивать два разных изменения. Фикстура tests/fixtures/speech.mp4 (эталон
# размечен при её генерации), среднее / максимальное отклонение границ фраз:
#                          с обрезкой        без обрезки
#   faster_whisper/small   216 мс / 829      234 мс / 829
#   faster_whisper/medium  119 мс / 272      185 мс / 669
#   whisperx/small          46 мс / 101       46 мс / 101
#   whisperx/medium         46 мс / 101       46 мс / 101
# На рабочем языке (русский, samples/phase-0-source.mp4, эталон — энергия
# сигнала: `--media`), отклонение НАЧАЛА первого слова после паузы:
#   faster_whisper/small    88 мс / 264      277 мс / 949
#   faster_whisper/medium  104 мс / 349      149 мс / 349
#   whisperx/small          25 мс /  53       25 мс /  53
# То есть разрыв 4.7× на фикстуре и 3.5× на русском. Сверх среднего: на русском
# faster_whisper/small растянул одно слово через паузу целиком — подсветка на нём
# висит всю паузу, а нарезка эту паузу не видит; у whisperx таких слов нет.
# Цена на 20-секундном ролике (12 ядер, без GPU, int8, 4 потока):
# 22 с против 7 с холодным стартом, 2.7 ГБ против 1.0 ГБ памяти.
#
# ⚠ Модель выравнивания качается ОДИН РАЗ на язык и тянется с huggingface.co:
# сами веса для русского ~1.2 ГБ, но в кеше ~/.cache/huggingface набегает больше
# (здесь 3.8 ГБ на язык — веса в двух форматах и языковая модель репозитория),
# так что закладывайтесь на несколько гигабайт диска. Если сеть режет большие
# файлы, whisperx сам скажет об этом в лог и досчитает ролик на faster_whisper —
# но лучше прогреть заранее:
#   python -c "from src.pipeline.asr import prewarm; prewarm()"
# Совсем без сети выручает ASR_BACKEND=faster_whisper.
ASR_BACKEND=auto
# tiny/base/small/medium/large-v3
#
# small, а не medium: границы слов считает wav2vec2 по звуку, поэтому НА ОДНОМ И
# ТОМ ЖЕ ТЕКСТЕ размер модели Whisper их не двигает — на английской фикстуре
# small и medium дали побуквенно одинаковые списки слов и тайминги. На русском
# medium меняет сам текст (38 слов против 39, «насчет того» вместо «о том»), а с
# текстом едет и сегментация — но точность попадания в речь та же (25 мс / 53).
# Стоит при этом medium вдвое дороже: 31 с против 22 с на 20-секундном ролике и
# 3.5 ГБ против 2.7 ГБ памяти. Ставить medium имеет смысл только ради самого
# текста, на плохой записи — но и там он не бесспорен: на эталонном ролике
# medium расслышал «в этой мире» там, где small расслышал «в этом мире».
WHISPER_MODEL=small
# Пусто = автоопределение языка
WHISPER_LANGUAGE=ru
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
# 4, а не «все ядра»: пиковое потребление важнее пары секунд (то же правило, что
# у FFMPEG_THREADS — на ноутбуке два жадных процесса гасят машину).
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=5
# Сегменты со средней уверенностью слов ниже порога — галлюцинации на музыке/шуме
WHISPER_MIN_CONFIDENCE=0.55

# Оба бэкенда растягивают ПОСЛЕДНЕЕ слово перед паузой на саму паузу: whisperx
# отдал «других» 10.80..13.00 при том, что речь кончилась на 11.17. Подсветке
# это ещё простительно, а нарезке — нет: она считает паузу как зазор МЕЖДУ
# словами и спрятанную внутрь слова не видит. Обрезка возвращает границы слова к
# фактической речи по энергии сигнала. Что это даёт, замерено двумя способами:
#   - нарезка пауз на эталонном ролике: 0.98 с вырезано без обрезки против
#     3.44 с с обрезкой (из 20.01 с) — те самые паузы, спрятанные внутрь слов;
#   - точность границ на фикстуре с РАЗМЕЧЕННЫМИ границами: faster_whisper/medium
#     185 → 119 мс, /small 234 → 216 мс (whisperx на ней не трогается вовсе).
# ⚠ Числа вида «конец речи попадает в 14 мс вместо 537» на русском ролике —
# это согласие двух замеров энергии по одному и тому же wav (обрезка ставит
# границу по своему порогу RMS, метрика меряет расстояние до порога ffmpeg
# silencedetect), а не независимая проверка точности. Цитировать их как точность
# нельзя.
ASR_TRIM_WORD_SILENCE=1

# ============================================================ Лимиты

MIN_VIDEO_SECONDS=3
MAX_VIDEO_MINUTES=3
MAX_CONCURRENT_JOBS=1
QUEUE_MAX_SIZE=20

# ============================================================ Нарезка пауз (M6)

# Пауза между словами длиннее этого — вырезается
CUT_MAX_GAP=1.2
CUT_PAD_BEFORE=0.15
CUT_PAD_AFTER=0.25
CUT_MIN_SEGMENT=0.3
# Если речи меньше этой доли длительности — считаем, что речи нет, и не режем
MIN_SPEECH_RATIO=0.05

# ============================================================ Субтитры

# 3-5 слов в блоке (§3). Ограничения на случай, когда блоки строит не LLM.
SUB_MAX_WORDS=4
SUB_MAX_CHARS=22
SUB_GAP_SPLIT=0.6
# Сколько блок висит после последнего слова
SUB_TAIL=0.15

# ============================================================ Рендер

# remotion — нормальный рендер (M5); ass — быстрый путь без Node (M3)
RENDER_BACKEND=remotion
RENDER_FPS=30
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
# Сколько вкладок Chromium параллельно. Больше — быстрее и прожорливее по RAM.
RENDER_CONCURRENCY=2
# Тема по умолчанию, она же первая вкладка в приложении.
# pulse — тот же вид, что glass, но слово выезжает и акцент пульсирует. glass
# остаётся выбором: это покадровая копия эталона, у которого субтитры почти не
# двигаются, — честно, но как умолчание читается вяло.
DEFAULT_PRESET=pulse
FONTS_DIR=./assets/fonts

# ============================================================ Звук (Ф2)

# Этап audio_post между нарезкой и рендером: loudnorm речи, музыкальная
# подложка с дакингом, whoosh на входе картинки. 0 — оставить звук как есть.
AUDIO_POST_ENABLED=1
# Свой музыкальный трек кладут сюда и включают в пресете (см. assets/music/README.md).
# Репозиторий музыку не везёт: лицензию проверяет тот, кто её кладёт.
MUSIC_DIR=./assets/music
# Эффекты синтезируются кодом; если папка пуста, соберутся при первом ролике.
SFX_DIR=./assets/sfx

# ============================================================ B-roll (M7)

# Вставки только рисуются по описанию кадра — стока нет. Без ключа выбранного
# генератора b-roll пропускается целиком. Живость картинке даёт медленный наезд
# (Ken Burns, М3) и плавное появление.
BROLL_ENABLED=1

# Чем рисуем.
#
# wavespeed — рабочий путь: z-image/turbo стоит $0.005 за картинку, то есть
# около трёх центов на ролик. Референсов не принимает, и вставку с роликом
# связывают только слова стилевой памятки (палитра, свет и настроение, снятые
# vision-моделью с кадров самого ролика).
#
# gemini — лучше: он принимает кадры ролика референсом палитры и света, и
# вставка попадает в тот самый ролик, а не живёт рядом. ⚠ Но нужен ПЛАТНЫЙ
# ключ: на бесплатном тарифе у всех его моделей картинок квота ровно нулевая
# («limit: 0 requests per day on Free Tier» — это не исчерпанный лимит, а его
# отсутствие). Появился платный ключ — переключается этой одной строкой.
#
# fal — та же z-image/turbo, но синхронно: ответ за 1-3 с вместо опроса.
# $0.005 за мегапиксель, кадр FAL_SIZE ~$0.0066. Референсов не принимает.
IMAGE_PROVIDER=fal
# Пусто → модель по умолчанию: z-image/turbo или gemini-3.1-flash-image.
IMAGE_MODEL=
# Разрешение у Gemini: 1K хватает на вертикаль 1080x1920, 2K стоит дороже.
# У WaveSpeed и fal размер задаётся отдельно, в WAVESPEED_SIZE и FAL_SIZE ниже.
IMAGE_SIZE=1K
# Спрашивать ли у vision-модели, то ли нарисовано и нет ли на картинке надписей.
# Одна дешёвая проверка на вставку и одна повторная попытка; не помогло —
# вставка отменяется. 0 отключает проверку вместе с её ценой.
#
# ⚠ Проверка идёт через тот же LLM, что и весь пайплайн, и живёт на его квоте.
# На бесплатном ключе Gemini это ~5 запросов в сутки: первого-второго ролика
# хватит, дальше проверка молча начнёт пропускать всё. Осечка проверки всегда
# считается «годится» — она предохранитель, а не судья.
BROLL_VERIFY=1
# Сколько дней держать кеш картинок. Кеш общий на все ролики: одна и та же
# картинка не должна стоить дважды.
BROLL_CACHE_DAYS=14

# Генерация: https://wavespeed.ai/accesskey
WAVESPEED_API_KEY=
WAVESPEED_MODEL=wavespeed-ai/z-image/turbo
# 4:5 — пропорция карточки, которая встаёт по центру поверх размытого кадра.
# Модель принимает не всякий размер: 864*1536 и 768*1365 проходят, 900*1600 и
# 1080*1920 отвергаются (замерено на живом ключе) — потолок около 1.33 Мп.
WAVESPEED_SIZE=1024*1280
# Генерация через fal: https://fal.ai/dashboard/keys
FAL_API_KEY=
# 4:5. Платят за мегапиксели, а разницу съедают Ken Burns и пережатие в Telegram.
FAL_SIZE=1024*1280
# Пропорция у Gemini (он берёт её словами).
IMAGE_ASPECT=4:5

# ============================================================ Рендер и хранение

# Потоки рендера. На ноутбуке 1 (два дают скачок тока), на сервере — по ядрам.
RENDER_CONCURRENCY=1
# medium | fast | veryfast. Рендер упирается в отрисовку кадров, не в кодек.
RENDER_X264_PRESET=medium
# Пусто = swangle. ⚠ На сервере без GPU angle не даёт WebGL2: вспышка на вставках
# (leak_ms в пресете) тогда пропускается. Замер 2026-10-27 на сервере: swangle 63 с,
# angle 77 с на 17-секундный ролик — swangle не медленнее.
RENDER_GL=
# s3 (MinIO) или local (папка на диске, для одного сервера)
STORAGE_BACKEND=s3
# Сколько дней хранить исходники и готовые ролики; 0 — не удалять
STORAGE_RETENTION_DAYS=7

# ============================================================ Mini App

# Telegram открывает приложение только по https. Свой домен → WEBAPP_URL.
# Без домена WEBAPP_TUNNEL=1 поднимет Cloudflare quick tunnel: адрес новый на
# каждом запуске, кнопка меню бота перевешивается на него сама.
WEBAPP_URL=
WEBAPP_TUNNEL=1
WEBAPP_PORT=8080
# Загрузка кусками: бесплатный туннель режет тело запроса на 100 МБ.
WEBAPP_CHUNK_MB=8
WEBAPP_MAX_UPLOAD_MB=1024

# ============================================================ Оплата (Telegram Stars)

# Пакеты {"роликов": звёзд}. Владельцы из ADMIN_IDS монтируют бесплатно;
# уберите свой id оттуда, чтобы проверить пейволл как обычный пользователь.
STAR_PACKAGES={"1": 50, "5": 200, "20": 600}

# ============================================================ Прочее

# DEBUG=1 сохраняет рабочую папку джоба (не удаляет после завершения)
DEBUG=0
LOG_LEVEL=INFO
