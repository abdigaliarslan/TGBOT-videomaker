    "@remotion/effects": "4.0.520",
    "@remotion/media": "4.0.520",
    "@remotion/renderer": "4.0.520",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
