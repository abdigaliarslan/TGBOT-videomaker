[Unit]
Description=ReelBot — уборка рабочих папок
After=reelbot-migrate.service reelbot-redis.service
Requires=reelbot-migrate.service reelbot-redis.service

[Service]
WorkingDirectory=%h/reelbot
Environment=PATH=%h/reelbot-runtime/bin:%h/reelbot-runtime/venv/bin:%h/.nvm/versions/node/v20.20.2/bin:/usr/local/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=%h/reelbot-runtime/sys/usr/lib/x86_64-linux-gnu
Environment=HF_HOME=%h/reelbot-runtime/hf
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/reelbot-runtime/venv/bin/python -m arq src.worker.tasks.LightWorkerSettings
Restart=always
RestartSec=5
CPUQuota=25%
MemoryMax=256M
TimeoutStopSec=30

[Install]
WantedBy=default.target
