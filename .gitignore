.venv/
.env
.env.docker
__pycache__/
*.pyc
.pytest_cache/
.playwright-mcp/

# рабочие папки джобов, кеш картинок, том Bot API
data/

# node и артефакты рендера
render/node_modules/
render/.cache/
.remotion/

# видео: в репозитории только демо; фикстуры собираются скриптом
*.mp4
*.mov
*.wav
!assets/demo.mp4
# исключение — эталон и базовый выход Ф0: их нельзя пересобрать скриптом
# (реальная запись + недетерминированный LLM), а без них не с чем сравнивать
!samples/*.mp4

# Рабочие папки прогонов `run_pipeline.py --keep-work`: артефакты из них
# кладутся в samples/ поимённо, сама папка в репозиторий не едет.
samples/.work-*/

# секреты сервера, собираются deploy.sh
deploy/.env

# локальное: логи ручных прогонов, метаданные pip install -e, кеши линтера,
# личные настройки и worktree агентов
logs/
*.egg-info/
.ruff_cache/
.kilo/
.claude/settings.local.json
.claude/worktrees/
